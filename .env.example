# `npm run sandbox:up` creates .env from this file and fills the secrets with random values.
# Most variables are for the local sandbox; in AWS the CDK sets them on each function. The last block sets the deployment.

# Postgres in Docker (admin user of the sandbox database).
LUMIA_SANDBOX_DB_PASSWORD=
LUMIA_SANDBOX_DB_PORT=5432

# Database access of the API: `pg` locally, `data-api` in AWS.
LUMIA_DB_DRIVER=pg
LUMIA_DB_NAME=lumia_studio
LUMIA_PG_HOST=127.0.0.1
LUMIA_PG_PORT=5432
LUMIA_DB_STUDIO_APP_PASSWORD=
LUMIA_DB_CLUSTER_ARN=
LUMIA_DB_SECRET_ARN=

# Local server that replaces AppSync, Cognito and S3.
LUMIA_API_PORT=4000
LUMIA_API_BASE_URL=http://localhost:4000
LUMIA_DEV_JWT_SECRET=
LUMIA_STORAGE_DRIVER=filesystem
LUMIA_STORAGE_ROOT=.sandbox/storage
LUMIA_STORAGE_SIGNING_SECRET=
LUMIA_MEDIA_BUCKET=

# Narration: `polly` in AWS, `none` in the sandbox.
LUMIA_SPEECH_PROVIDER=none
AWS_REGION=us-east-1

# Studio web dev server.
LUMIA_WEB_PORT=5173

# Lumi, the co-creation agent (apps/agent), and the local stand-in for its AgentCore Gateway (`mcp` service).
# Bedrock access comes from the AWS credentials of the shell or from BEDROCK_API_KEY, which is never kept here.
LUMI_PORT=8080
LUMIA_MCP_PORT=4100
LUMI_MCP_URL=http://localhost:4100/mcp
LUMI_SESSION_DIR=.sandbox/lumi/sessions
LUMI_MEMORY_DIR=.sandbox/lumi/memory
LUMI_MODEL_ID=us.anthropic.claude-sonnet-4-6

# AWS deployment (`npm run deploy`). Account and region default to the ones of the AWS CLI profile.
LUMIA_AWS_ACCOUNT=
LUMIA_AWS_REGION=
# Aurora Serverless v2 capacity in ACU (0 lets the database pause when idle), and minutes without use before it pauses.
LUMIA_DB_MIN_ACU=0
LUMIA_DB_MAX_ACU=1
LUMIA_DB_AUTO_PAUSE_MINUTES=5
# AgentCore Runtime ARN that runs Lumi (the other agent's stack); empty until it exists. With it, the entry gateway
# and its URL are created, and the web uses that URL unless LUMIA_LUMI_URL is set.
LUMIA_LUMI_RUNTIME_ARN=
# AG-UI endpoint of Lumi for the web; empty to use the entry gateway URL (or while Lumi is not deployed).
LUMIA_LUMI_URL=
